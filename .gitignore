# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Allow the Gradle wrapper jar to be tracked
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Local secrets — never commit the Maps API key
local.properties

# Android Gradle build artefacts
.gradle/
build/
app/build/

# Gradle wrapper jar (only the properties file is tracked)
# gradle/wrapper/gradle-wrapper.jar

# Android Studio project files
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Allow APK files in the artifacts directory
!artifacts/*.apk
